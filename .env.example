# =============================================
# Lexora RAG Service — Environment Variables Example
# Model Version: Lexora Origin v1
# =============================================

# Port this Python service runs on
PORT=8000

# Ollama base URL (running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model names
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=lexora-origin:v1

# ChromaDB — where vectors are stored on disk
CHROMA_DB_PATH=./chroma_db

# Node.js backend URL (for CORS)
NODE_BACKEND_URL=http://localhost:5000
